# --- Required for every module -------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Module 04 (external agents) only ------------------------------------
# Both values come from Agent Manager after registering this agent as an
# Externally-Hosted Agent: Overview -> <environment> -> Setup Agent.
# Leave blank until you reach module 04.
AMP_OTEL_ENDPOINT=
AMP_AGENT_API_KEY=
